class Solution {
    public long maxAlternatingSum(int[] nums) {
        Arrays.sort(nums);

        long sum = 0;
        int n = nums.length;

        for (int i = 0; i < n; i++) {
            long x = nums[i];
            long square = x * x;

            if (i < (n + 1) / 2) {
                sum += square;
            } else {
                sum -= square;
            }
        }

        return sum;
    }
}
