class Solution {
    public int maxLength(int[] nums) {
        Map<Integer, Integer> map = new HashMap<>();

        int left = 0;
        int ans = 0;

        for (int right = 0; right < nums.length; right++) {

            List<Integer> factors = getPrimeFactors(nums[right]);

            while (true) {
                boolean valid = true;

                for (int p : factors) {
                    if (map.getOrDefault(p, 0) >= 2) {
                        valid = false;
                        break;
                    }
                }

                if (valid) {
                    break;
                }

                List<Integer> leftFactors = getPrimeFactors(nums[left]);

                for (int p : leftFactors) {
                    map.put(p, map.get(p) - 1);

                    if (map.get(p) == 0) {
                        map.remove(p);
                    }
                }

                left++;
            }

            for (int p : factors) {
                map.put(p, map.getOrDefault(p, 0) + 1);
            }

            ans = Math.max(ans, right - left + 1);
        }

        return ans;
    }

    private List<Integer> getPrimeFactors(int n) {
        List<Integer> factors = new ArrayList<>();

        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                factors.add(i);

                while (n % i == 0) {
                    n /= i;
                }
            }
        }

        if (n > 1) {
            factors.add(n);
        }

        return factors;
    }
}
