class Solution {
    public String reverseParentheses(String s) {
        StringBuilder stack = new StringBuilder();

        for (char ch : s.toCharArray()) {

            if (ch == ')') {
                int i = stack.length() - 1;

                while (stack.charAt(i) != '(') {
                    i--;
                }

                int left = i + 1;
                int right = stack.length() - 1;

                while (left < right) {
                    char temp = stack.charAt(left);
                    stack.setCharAt(left, stack.charAt(right));
                    stack.setCharAt(right, temp);

                    left++;
                    right--;
                }

                stack.deleteCharAt(i);

            } else {
                stack.append(ch);
            }
        }

        return stack.toString();
    }
}
